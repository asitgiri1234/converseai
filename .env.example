# Copy this file to `.env` and fill in your key. `.env` is gitignored.

# Required. Get one at https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# Optional. Overrides the default model used by agent/llm.py.
# Any Groq model with tool-calling support works; these are known good:
#   openai/gpt-oss-120b       (default)
#   llama-3.3-70b-versatile
#   qwen/qwen3.6-27b
# GROQ_MODEL=openai/gpt-oss-120b
